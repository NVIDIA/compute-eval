# =============================================================================
# Dockerfile.local — Self-contained image for running the eval harness on any
# machine with Docker and an NVIDIA GPU
# =============================================================================
#
# PURPOSE:
#   An all-in-one image that bundles the compute-eval harness together with its
#   full runtime environment. Built on top of the compute-eval:<CUDA_VERSION>
#   sandbox image (docker/Dockerfile.eval) so the harness and evaluation
#   containers always share identical CUDA / Python environments.
#
# BUILD (run from repo root):
#   # Requires the compute-eval base image to be built (or pulled) first:
#   docker build -f docker/Dockerfile.eval -t compute-eval:13.1.0 .
#
#   docker build -f docker/Dockerfile.local -t compute-eval:local .
#
# RUN EXAMPLE:
#   docker run --rm --gpus all \
#     -v $(pwd)/solutions:/app/solutions \
#     -v $(pwd)/results:/app/results \
#     compute-eval:local \
#     compute_eval evaluate_functional_correctness \
#     --release=2026-1 \
#     --solutions_datapack=/app/solutions \
#     --k=1 \
#     --n_workers=10 \
#     --mode=local
#
# INCLUDED PACKAGES (via compute-eval base image):
#   - CUDA 13.1.0 development toolchain + cuDNN 9 (pinned)
#   - cudnn-frontend v1.10.0 headers
#   - Python venv (/opt/cuda-python-venv): CuPy, cuda-tile, PyTorch, NumPy,
#     SciPy, pandas, scikit-learn, matplotlib, numba, nvtx, pytest, pyyaml
#   - CUPTI-based profiling library
#
# ADDED BY THIS IMAGE:
#   - Full compute-eval harness installed via uv into /app/.venv
#
# =============================================================================

ARG CUDA_VERSION=13.1.0
FROM compute-eval:${CUDA_VERSION}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

# Additional system packages needed only for the harness (not in sandbox)
RUN apt-get update && apt-get install -y --no-install-recommends \
        jq \
        curl \
        wget \
        unzip \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Eval harness
# =============================================================================
WORKDIR /app

COPY *.toml ./
RUN uv sync --no-install-project

COPY . ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync

# =============================================================================
# Environment
# =============================================================================
ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONPATH=/app \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

WORKDIR /app

CMD ["/bin/bash"]
